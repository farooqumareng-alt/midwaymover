{
  "name": "midwaymover",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "nodemailer": "10.0.1"
  },
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run db:generate && npm run build --workspace apps/web",
    "start": "npm run start --workspace apps/web",
    "lint": "npm run lint --workspace apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run generate --workspace packages/db",
    "db:migrate": "npm run migrate:dev --workspace packages/db",
    "db:studio": "npm run studio --workspace packages/db"
  }
}
