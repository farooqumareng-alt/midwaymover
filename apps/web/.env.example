# Copy to .env and fill in — never commit the real .env.
# See docs/DEV-SETUP.md for the local Postgres instance this points at.
DATABASE_URL="postgresql://midwaymover:CHANGE_ME@127.0.0.1:5439/midwaymover_dev?schema=public"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY="CHANGE_ME_32_RANDOM_BYTES_BASE64"

# Auth.js session/CSRF signing secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="CHANGE_ME_32_RANDOM_BYTES_BASE64"

# Optional: sender address for magic-link emails (no real email provider is
# wired yet — see auth.ts and docs/PHASE-0-SPECIFICATION.md §M).
# AUTH_EMAIL_FROM="no-reply@midwaymover.com"
