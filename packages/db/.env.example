# Copy to .env and fill in — never commit the real .env.
# Local dev default (see docs/DEV-SETUP.md for how this local instance was created):
DATABASE_URL="postgresql://midwaymover:CHANGE_ME@127.0.0.1:5439/midwaymover_dev?schema=public"

# Optional locally (falls back to DATABASE_URL — see prisma7.config.ts).
# In production (Supabase): set this to Supabase's DIRECT connection
# string (port 5432, Database Settings > Connection string > Direct
# connection). The Prisma CLI (migrate/generate) uses this one.
# DIRECT_DATABASE_URL="postgresql://..."

# In production: DATABASE_URL is what the *deployed app* actually connects
# through (packages/db/src/client.ts) — use Supabase's POOLED connection
# string (port 6543, "Connection pooling", transaction mode) there, not
# the direct one, so serverless concurrency doesn't exhaust Postgres
# connections. Never reuse a dev credential in staging/production.
